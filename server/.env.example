NODE_ENV=development
PORT=4000

# Replica set is required (transactions). Atlas works out of the box;
# locally use `docker compose up -d` (see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/doctor_tracker?replicaSet=rs0&directConnection=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:3000

# Timezone used to bucket dashboard statistics by day/month
STATS_TIMEZONE=UTC

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
